# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA debe subirse al repositorio.

# Proveedor del modelo de lenguaje: anthropic | azure_openai | mock
LLM_PROVIDER=mock

# Credencial del proveedor elegido (dejar vacío si LLM_PROVIDER=mock)
LLM_API_KEY=

# Opcional: endpoint, solo si usas Azure OpenAI
LLM_ENDPOINT=

# Rutas
INPUT_PATH=data/solicitudes_oct.jsonl
OUTPUT_PATH=salida.jsonl

# Clave de API para el proveedor de LLM (ej. OpenAI)
OPENAI_API_KEY=
